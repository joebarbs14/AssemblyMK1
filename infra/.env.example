# --- API (apps/api/.env) ---
ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assembly
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
SENTRY_DSN=

# Resident JWT signing (RS256)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_MEDIA=assembly-media-dev
R2_BUCKET_PMTILES=assembly-pmtiles-dev

# PayPal (sandbox in dev)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# Email (Resend)
RESEND_API_KEY=
RESEND_SENDER_DOMAIN=

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
AUTH_SECRET=
SENTRY_DSN=
